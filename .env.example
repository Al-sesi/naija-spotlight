# ============================================================
# NAIJALIFT — Environment Variables (reference template)
# ============================================================
# Copy this file to `.env.local` and fill in the values.
# .env.local is git-ignored — NEVER commit real secrets.
#
# ALSO add these to:
#   Vercel → Project → Settings → Environment Variables
#   (scope: Production + Preview + Development)
# ============================================================

# ------------------------------------------------------------
# 1. SUPABASE (REQUIRED — frontend client)
# ------------------------------------------------------------
# The app hardcodes Supabase URL + anon key in client.ts,
# but setting them here is strongly recommended so you can
# easily swap between local/remote projects later.

VITE_SUPABASE_URL=https://vdliauwtxklhlkltqqua.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZkbGlhdXd0eGtsaGxrbHRxcXVhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjczNzI3NTgsImV4cCI6MjA4Mjk0ODc1OH0.OQVOHYxBwOx55jC5wC-8uLYanbs-4cf0IJCBsZ3picQ

VITE_USE_LOCAL_EMULATORS=false

# ------------------------------------------------------------
# 2. STRIPE — Billing / Premium subscriptions
# ------------------------------------------------------------
# Publishable key (safe to expose to browser) + the Premium
# Monthly price ID ("price_xxx" from Stripe dashboard).

VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PREMIUM_MONTHLY_PRICE_ID=

# ------------------------------------------------------------
# 3. GOOGLE ADSENSE — Monetization (AUTO ADS = default, recommended)
# ------------------------------------------------------------
# MODE:
#   "auto"   → Google AUTO ADS (the default, recommended for NAIJALIFT).
#              Google automatically places ads across the page for best fill
#              and revenue. You only need the PUB_ID — no slot IDs required.
#              Set this once in your AdSense dashboard:
#                AdSense → Ads → Overview → Get code → Paste the snippet
#              (the index.html snippet below is already the correct format).
#   "manual" → If you want per-slot control via VITE_ADSLOT_* below.
#
# PUB_ID — your AdSense Publisher ID (numeric part of ca-pub-XXXXXXXXXXXXXXXX)
#          Currently NAIJALIFT's active ID = 2262462453475038
VITE_ADSENSE_MODE=auto
VITE_ADSENSE_PUB_ID=2262462453475038

# MANUAL MODE ONLY (skip if using AUTO ADS — recommended)
# Individual ad SLOT IDs (numeric, ~10 digits) from AdSense UI:
#   AdSense → Ads → By ad unit → create unit → copy the slot id
#   Ad format recommendation:
#     FEED_NATIVE     = "In-feed native & content ads" (fluid)
#     BANNER_728x90   = "Leaderboard 728×90"           (desktop top banner)
#     BANNER_320x50   = "Banner 320×50"                (mobile top banner)
#     MEDIUM_RECT     = "Medium rectangle 300×250"      (sidebar sticky)
#     STICKY_BOTTOM   = "Anchor / banner 320×50"        (sticky footer ad)
#
# In AUTO MODE, these are ignored; Google places ads automatically.
VITE_ADSLOT_FEED_NATIVE=
VITE_ADSLOT_BANNER_728x90=
VITE_ADSLOT_BANNER_320x50=
VITE_ADSLOT_MEDIUM_RECT=
VITE_ADSLOT_STICKY_BOTTOM=

# ------------------------------------------------------------
# 4. GOOGLE ADS (AdWords conversion tracking — OPTIONAL)
# ------------------------------------------------------------
# If you run Google Ads search campaigns, set these to track
# sign-ups and premium purchases as conversions:

VITE_GOOGLE_ADS_ID=AW-
VITE_GOOGLE_ADS_CONVERSION_LABEL=

# Optional: Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_TAG_ID=

# ------------------------------------------------------------
# 5. OTHER — OPTIONAL
# ------------------------------------------------------------
VITE_APP_URL=https://naijalift.space

VITE_RECAPTCHA_SITE_KEY=
VITE_AMPLITUDE_API_KEY=
VITE_SENTRY_DSN=
